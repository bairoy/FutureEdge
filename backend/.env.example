# ============================================================
# FutureEdge — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!
# ============================================================

# ============================================================
# POSTGRESQL (required)
# ============================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=futureedge
POSTGRES_USER=futureedge
POSTGRES_PASSWORD=futureedge

# ============================================================
# REDIS (required)
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ============================================================
# QDRANT — Vector DB for episodic memory (required)
# ============================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ============================================================
# SECURITY (required for production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_secret
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars_for_aes256

# ============================================================
# AI — OpenAI GPT-4o (required for LLM rationale)
# ============================================================
OPENAI_API_KEY=sk-your-openai-key-here
LLM_REASONING_ENABLED=true
FINBERT_ENABLED=false

# ============================================================
# ZERODHA (Global fallback / admin credentials)
# Per-user credentials are stored encrypted in PostgreSQL.
# These are used for admin functions and mock mode testing.
# Obtain from: https://kite.trade/
# ============================================================
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_api_secret
ZERODHA_ACCESS_TOKEN=your_daily_access_token   # refreshed daily at 6 AM IST

# ============================================================
# NOTIFICATIONS — all alerts display on the dashboard
# Redis pub/sub channel: "futureedge:alerts"
# WhatsApp delivery is optional and currently disabled.
# ============================================================
WHATSAPP_ALERTS_ENABLED=false
ADMIN_WHATSAPP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ============================================================
# BROKER & FEED MODE
# mock  = paper trading (safe for testing)
# zerodha = live trading with real money
# ============================================================
ACTIVE_BROKER=mock
ACTIVE_FEED=mock

# ============================================================
# APPLICATION
# ============================================================
APP_ENV=development    # development | production
LOG_LEVEL=INFO

# CORS — set to your frontend domain in production
FRONTEND_URL=http://localhost:3000

# ============================================================
# TRADING PARAMETERS
# ============================================================
MAX_DAILY_LOSS_PCT=3.0               # kill switch triggers at 3% daily loss
TRAILING_STOP_TRIGGER_PCT=2.0        # activate trailing stop at 2% unrealized gain
TRAILING_STOP_DISTANCE_PCT=1.5       # trail SL 1.5% below peak
MAX_OPEN_TRADES_PORTFOLIO=3          # max simultaneous trades per user

# ============================================================
# LANGSMITH TRACING (optional)
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key
LANGCHAIN_PROJECT=futureedge